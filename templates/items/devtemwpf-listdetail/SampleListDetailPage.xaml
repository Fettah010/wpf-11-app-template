<Page x:Class="DevTemWpf.App.Views.SampleListDetailPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="900"
      Title="SampleListDetailPage">
  <Grid Margin="{StaticResource AppPageMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="SampleListDetailPage" Style="{StaticResource AppSubtitleText}" Margin="0,0,0,4" />
      <TextBlock Text="Master-detail pattern with list selection and item inspector."
                 Style="{StaticResource AppSecondaryBodyText}" />
    </StackPanel>

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="320" MinWidth="240" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="*" MinWidth="300" />
      </Grid.ColumnDefinitions>

      <!-- Master list -->
      <ui:Card Grid.Column="0" VerticalAlignment="Stretch" Padding="12">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
          </Grid.RowDefinitions>
          <ui:TextBox Grid.Row="0" PlaceholderText="Search items..."
                      Text="{Binding ViewModel.FilterText, UpdateSourceTrigger=PropertyChanged}"
                      Margin="0,0,0,12"
                      AutomationProperties.Name="Filter Items" />
          <ui:ListView Grid.Row="1"
                       ItemsSource="{Binding ViewModel.Items}"
                       SelectedItem="{Binding ViewModel.SelectedItem, Mode=TwoWay}"
                       DisplayMemberPath="Title"
                       AutomationProperties.Name="Item List" />
        </Grid>
      </ui:Card>

      <!-- Detail view -->
      <ui:Card Grid.Column="2" VerticalAlignment="Stretch" Padding="20">
        <StackPanel>
          <TextBlock Text="Item Details" Style="{StaticResource AppSectionHeadingText}" Margin="0,0,0,12" />
          <TextBlock Text="{Binding ViewModel.SelectedItem.Title, FallbackValue='Select an item from the list'}"
                     Style="{StaticResource AppSubtitleText}" Margin="0,0,0,8" />
          <TextBlock Text="{Binding ViewModel.SelectedItem.Description, FallbackValue='No item selected.'}"
                     Style="{StaticResource AppSecondaryBodyText}" TextWrapping="Wrap" Margin="0,0,0,12" />
          <TextBlock Text="{Binding ViewModel.SelectedItem.Category, StringFormat='Category: {0}'}"
                     Style="{StaticResource AppSecondaryBodyText}" />
        </StackPanel>
      </ui:Card>
    </Grid>
  </Grid>
</Page>
