<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:DevTemWpf.App.Controls">

    <Style TargetType="{x:Type local:SampleValueEditor}">
        <Setter Property="Background" Value="{DynamicResource {x:Static SystemColors.ControlBrushKey}}" />
        <Setter Property="BorderBrush" Value="{DynamicResource {x:Static SystemColors.ControlDarkBrushKey}}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:SampleValueEditor}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            Padding="{TemplateBinding Padding}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding Title, RelativeSource={RelativeSource TemplatedParent}}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <RepeatButton Content="-"
                                          Command="{Binding DecrementCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                          Width="24" Margin="0,0,4,0" AutomationProperties.Name="Decrement value" />
                            <TextBlock Text="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, StringFormat={}{0}}"
                                       Width="36" VerticalAlignment="Center" TextAlignment="Center" />
                            <RepeatButton Content="+"
                                          Command="{Binding IncrementCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                          Width="24" Margin="4,0,0,0" AutomationProperties.Name="Increment value" />
                        </StackPanel>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
