{
  "$schema": "https://json.schemastore.org/template",
  "author": "DevTemWPF",
  "classifications": ["Desktop", "WPF", "MVVM"],
  "name": "DevTemWPF TreeView Page",
  "description": "Adds a hierarchical TreeView page with ViewModel and sample node model following project conventions.",
  "identity": "DevTemWPF.TreeViewPage.CSharp",
  "shortName": "devtemwpf-treeview",
  "sourceName": "SampleTreeViewPage",
  "tags": { "language": "C#", "type": "item" },
  "symbols": {
    "RootNamespace": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "DevTemWpf",
      "replaces": "DevTemWpf",
      "description": "Root namespace of the generated app (the .App suffix is preserved)."
    },
    "NodeName": {
      "type": "derived",
      "valueSource": "name",
      "valueTransform": "pageToNode",
      "replaces": "SampleTreeNode",
      "description": "Name of the generated node model (Page -> Node)."
    }
  },
  "forms": {
    "pageToNode": { "identifier": "replace", "pattern": "Page", "replacement": "Node" }
  },
  "sources": [
    {
      "source": "./",
      "target": "./",
      "exclude": [".template.config/**"]
    }
  ]
}
