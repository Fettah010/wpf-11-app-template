<Page x:Class="DevTemWpf.App.Views.SampleTreeViewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="SampleTreeViewPage">
  <Grid Margin="{StaticResource AppPageMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="SampleTreeViewPage" Style="{StaticResource AppSubtitleText}" Margin="0,0,0,4" />
      <TextBlock Text="Hierarchical tree view with expand/collapse nodes and selection details."
                 Style="{StaticResource AppSecondaryBodyText}" Margin="0,0,0,16" TextWrapping="Wrap" />
    </StackPanel>

    <ui:Card Grid.Row="1" VerticalAlignment="Stretch" Padding="12">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="320" MinWidth="240" />
          <ColumnDefinition Width="16" />
          <ColumnDefinition Width="*" MinWidth="300" />
        </Grid.ColumnDefinitions>

        <!-- Master tree -->
        <TreeView Grid.Column="0"
                  ItemsSource="{Binding ViewModel.Nodes}"
                  SelectedItemChanged="OnTreeSelectedItemChanged"
                  AutomationProperties.Name="Tree Nodes">
          <TreeView.ItemContainerStyle>
            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
              <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
              <Setter Property="Padding" Value="{StaticResource AppGapFlow}" />
            </Style>
          </TreeView.ItemContainerStyle>
          <TreeView.ItemTemplate>
            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
              <TextBlock Text="{Binding Title}" />
            </HierarchicalDataTemplate>
          </TreeView.ItemTemplate>
        </TreeView>

        <!-- GridSplitter -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch" />

        <!-- Detail view -->
        <ui:Card Grid.Column="2" VerticalAlignment="Stretch" Padding="20">
          <StackPanel>
            <TextBlock Text="Node Details" Style="{StaticResource AppSectionHeadingText}" Margin="0,0,0,12" />
            <TextBlock Text="{Binding ViewModel.SelectedNode.Title, FallbackValue='Select a node from the tree'}"
                       Style="{StaticResource AppSubtitleText}" Margin="0,0,0,8" />
            <TextBlock Text="{Binding ViewModel.SelectedNode.Description, FallbackValue='No node selected.'}"
                       Style="{StaticResource AppSecondaryBodyText}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <TextBlock Text="{Binding ViewModel.SelectedNode.Level, StringFormat='Depth: {0}'}"
                       Style="{StaticResource AppSecondaryBodyText}" />
          </StackPanel>
        </ui:Card>
      </Grid>
    </ui:Card>
  </Grid>
</Page>
