<Page x:Class="DevTemWpf.App.Views.SampleSettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="SampleSettingsPage">
  <ScrollViewer Padding="{StaticResource AppPageMargin}"
                AutomationProperties.Name="SampleSettingsPage">
    <StackPanel MaxWidth="{StaticResource AppContentMaxWidth}">
      <TextBlock Text="SampleSettingsPage" Style="{StaticResource AppSubtitleText}" Margin="0,0,0,4" />
      <TextBlock Text="Manage sample options and application preferences."
                 Style="{StaticResource AppSecondaryBodyText}" Margin="0,0,0,16" TextWrapping="Wrap" />

      <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Symbol=Options24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="Feature Toggle" Style="{StaticResource AppSectionHeadingText}" />
            <TextBlock Text="Enable or disable the sample feature." Style="{StaticResource AppSecondaryBodyText}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:ToggleSwitch IsChecked="{Binding ViewModel.FeatureEnabled, Mode=TwoWay}"
                         AutomationProperties.Name="Feature Toggle" />
      </ui:CardControl>

      <ui:CardControl Margin="0,0,0,12" Icon="{ui:SymbolIcon Symbol=ArrowReset24}">
        <ui:CardControl.Header>
          <StackPanel>
            <TextBlock Text="Reset Defaults" Style="{StaticResource AppSectionHeadingText}" />
            <TextBlock Text="Restore default configuration options." Style="{StaticResource AppSecondaryBodyText}" />
          </StackPanel>
        </ui:CardControl.Header>
        <ui:Button Content="Reset"
                   Command="{Binding ViewModel.ResetOptionsCommand}"
                   AutomationProperties.Name="Reset Defaults" />
      </ui:CardControl>
    </StackPanel>
  </ScrollViewer>
</Page>
