<Page x:Class="DevTemWpf.App.Views.SampleTabPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="600" d:DesignWidth="800"
      Title="SampleTabPage">
  <Grid Margin="{StaticResource AppPageMargin}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Margin="0,0,0,16">
      <TextBlock Text="SampleTabPage" Style="{StaticResource AppSubtitleText}" Margin="0,0,0,4" />
      <TextBlock Text="Document page designed for the Tabbed shell document manager workspace."
                 Style="{StaticResource AppSecondaryBodyText}" Margin="0,0,0,16" TextWrapping="Wrap" />
    </StackPanel>

    <ui:Card Grid.Row="1" VerticalAlignment="Stretch" Padding="16">
      <StackPanel>
        <TextBlock Text="Document content area" Style="{StaticResource AppSectionHeadingText}" Margin="0,0,0,8" />
        <TextBlock Text="This page is intended to be hosted inside a tab of the Tabbed shell workspace.
              It follows the same INavigableView contract as every other page and can be
              registered for navigation and opened as a document tab."
                   Style="{StaticResource AppSecondaryBodyText}" TextWrapping="Wrap" Margin="0,0,0,16" />

        <ui:Button Content="Open sibling document"
                   Command="{Binding ViewModel.OpenSiblingCommand}"
                   AutomationProperties.Name="Open sibling document" Margin="0,0,0,12" />
      </StackPanel>
    </ui:Card>
  </Grid>
</Page>
