<!-- Comfortable density spacing. Swapped whole-file for Compact (see DesignTokenBootstrap). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

  <Thickness x:Key="AppPageMargin">24</Thickness>
  <Thickness x:Key="AppCardPadding">16</Thickness>
  <!-- Gap rhythm (1.2.0): bottom-flowing stack gaps. Comfortable values match
       the pre-1.2.0 literal rhythm exactly; Compact tightens it. -->
  <Thickness x:Key="AppGapTitle">0,0,0,4</Thickness>
  <Thickness x:Key="AppGapItem">0,0,0,8</Thickness>
  <Thickness x:Key="AppGapGroup">0,0,0,12</Thickness>
  <Thickness x:Key="AppGapSection">0,0,0,16</Thickness>
  <Thickness x:Key="AppGapFlow">0,0,8,8</Thickness>
  <Thickness x:Key="AppGapInline">0,0,16,8</Thickness>
  <Thickness x:Key="AppGapGutter">0,0,12,0</Thickness>
  <system:Double x:Key="AppSectionSpacing">24</system:Double>
  <system:Double x:Key="AppItemSpacing">12</system:Double>
  <system:Double x:Key="AppControlSpacing">8</system:Double>
  <system:Double x:Key="AppContentMaxWidth">640</system:Double>

</ResourceDictionary>
