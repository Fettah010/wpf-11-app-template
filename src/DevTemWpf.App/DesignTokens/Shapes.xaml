<!-- Radii and border metrics. Theme-independent. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

  <CornerRadius x:Key="AppCornerRadiusSmall">4</CornerRadius>
  <CornerRadius x:Key="AppCornerRadiusMedium">8</CornerRadius>
  <CornerRadius x:Key="AppCornerRadiusLarge">12</CornerRadius>

  <Thickness x:Key="AppBorderThickness">1</Thickness>
  <Thickness x:Key="AppFocusThickness">2</Thickness>

</ResourceDictionary>
