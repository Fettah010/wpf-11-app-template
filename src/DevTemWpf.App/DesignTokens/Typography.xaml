<!-- Type ramp. Theme-independent; foregrounds alias semantic brushes. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

  <FontFamily x:Key="AppFontFamily">Segoe UI Variable, Segoe UI</FontFamily>
  <FontFamily x:Key="AppMonoFontFamily">Cascadia Mono, Consolas</FontFamily>

  <Style x:Key="AppDisplayText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="32" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
  </Style>

  <Style x:Key="AppTitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="22" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
  </Style>

  <Style x:Key="AppSubtitleText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
  </Style>

  <Style x:Key="AppSectionHeadingText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
  </Style>

  <Style x:Key="AppBodyText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextPrimaryBrush}" />
  </Style>

  <Style x:Key="AppSecondaryBodyText" TargetType="TextBlock" BasedOn="{StaticResource AppBodyText}">
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
  </Style>

  <Style x:Key="AppCaptionText" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{StaticResource AppFontFamily}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource AppTextSecondaryBrush}" />
  </Style>

  <Style x:Key="AppErrorText" TargetType="TextBlock" BasedOn="{StaticResource AppCaptionText}">
    <Setter Property="Foreground" Value="{DynamicResource AppErrorBrush}" />
  </Style>

  <!-- Icon sizes -->
  <system:Double x:Key="AppIconXLarge">56</system:Double>
  <system:Double x:Key="AppIconLarge">32</system:Double>
  <system:Double x:Key="AppIconSmall">16</system:Double>

</ResourceDictionary>
