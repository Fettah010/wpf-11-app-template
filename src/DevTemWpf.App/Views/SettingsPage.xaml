<Page x:Class="DevTemWpf.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="480" d:DesignWidth="720"
      Title="Settings">
  <ScrollViewer Padding="24">
    <StackPanel MaxWidth="520">
      <TextBlock Text="Appearance" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12" />

      <TextBlock Text="Theme" Margin="0,0,0,4" />
      <ComboBox ItemsSource="{Binding ViewModel.ThemeOptions}"
                SelectedItem="{Binding ViewModel.SelectedTheme, Mode=TwoWay}"
                AutomationProperties.Name="Theme selector" Margin="0,0,0,12" />

      <CheckBox Content="Enable Mica backdrop (falls back to opaque when unsupported)"
                IsChecked="{Binding ViewModel.BackdropEnabled, Mode=TwoWay}"
                AutomationProperties.Name="Mica backdrop toggle" Margin="0,0,0,12" />

      <TextBlock Text="Navigation style" Margin="0,0,0,4" />
      <ComboBox ItemsSource="{Binding ViewModel.ShellOptions}"
                SelectedItem="{Binding ViewModel.SelectedShell, Mode=TwoWay}"
                AutomationProperties.Name="Navigation style selector" Margin="0,0,0,12" />

      <TextBlock Text="{Binding ViewModel.ErrorMessage, TargetNullValue=''}" Foreground="Tomato"
                 TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Page>
