<Page x:Class="DevTemWpf.App.Views.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:res="clr-namespace:DevTemWpf.App.Resources"
      mc:Ignorable="d"
      d:DesignHeight="640" d:DesignWidth="720"
      Title="{x:Static res:Strings.Settings_Title}">
  <ScrollViewer Padding="{StaticResource AppPageMargin}"
                AutomationProperties.Name="Application settings">
    <StackPanel MaxWidth="{StaticResource AppContentMaxWidth}">
      <TextBlock Text="{x:Static res:Strings.Settings_Appearance}" Style="{StaticResource AppSubtitleText}" Margin="{StaticResource AppGapGroup}" />

      <TextBlock Text="{x:Static res:Strings.Settings_Theme}" Style="{StaticResource AppBodyText}" Margin="{StaticResource AppGapTitle}" />
      <ComboBox ItemsSource="{Binding ViewModel.ThemeOptions}"
                SelectedItem="{Binding ViewModel.SelectedTheme, Mode=TwoWay}"
                AutomationProperties.Name="Theme selector" Margin="{StaticResource AppGapGroup}" />

      <TextBlock Text="{x:Static res:Strings.Settings_Accent}" Style="{StaticResource AppBodyText}" Margin="{StaticResource AppGapTitle}" />
      <CheckBox Content="{x:Static res:Strings.Settings_CustomAccent}"
                IsChecked="{Binding ViewModel.UseCustomAccent, Mode=TwoWay}"
                AutomationProperties.Name="Custom accent toggle" Margin="{StaticResource AppGapTitle}" />
      <TextBox Text="{Binding ViewModel.AccentHex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
               IsEnabled="{Binding ViewModel.UseCustomAccent}"
               AutomationProperties.Name="Custom accent hex value"
               AutomationProperties.HelpText="{x:Static res:Strings.Settings_AccentHexHelp}"
               Margin="{StaticResource AppGapGroup}" />

      <CheckBox Content="{x:Static res:Strings.Settings_BackdropToggle}"
                IsChecked="{Binding ViewModel.BackdropEnabled, Mode=TwoWay}"
                AutomationProperties.Name="Mica backdrop toggle" Margin="{StaticResource AppGapGroup}" />

      <TextBlock Text="{x:Static res:Strings.Settings_NavigationStyle}" Style="{StaticResource AppBodyText}" Margin="{StaticResource AppGapTitle}" />
      <ComboBox ItemsSource="{Binding ViewModel.ShellOptions}"
                SelectedItem="{Binding ViewModel.SelectedShell, Mode=TwoWay}"
                AutomationProperties.Name="Navigation style selector" Margin="{StaticResource AppGapTitle}" />
      <TextBlock Text="{x:Static res:Strings.Settings_ShellNote}" Style="{StaticResource AppCaptionText}" Margin="{StaticResource AppGapTitle}" />

      <TextBlock Text="{x:Static res:Strings.Settings_Density}" Style="{StaticResource AppBodyText}" Margin="{StaticResource AppGapTitle}" />
      <ComboBox ItemsSource="{Binding ViewModel.DensityOptions}"
                SelectedItem="{Binding ViewModel.SelectedDensity, Mode=TwoWay}"
                AutomationProperties.Name="Density selector" Margin="{StaticResource AppGapGroup}" />

      <TextBlock Text="{x:Static res:Strings.Settings_Motion}" Style="{StaticResource AppBodyText}" Margin="{StaticResource AppGapTitle}" />
      <ComboBox ItemsSource="{Binding ViewModel.MotionOptions}"
                DisplayMemberPath="Display" SelectedValuePath="Value"
                SelectedValue="{Binding ViewModel.SelectedMotion, Mode=TwoWay}"
                AutomationProperties.Name="Motion selector" Margin="{StaticResource AppGapGroup}" />

      <CheckBox Content="{x:Static res:Strings.Settings_EffectsToggle}"
                IsChecked="{Binding ViewModel.EffectsEnabled, Mode=TwoWay}"
                AutomationProperties.Name="Effects toggle" Margin="{StaticResource AppGapGroup}" />

      <CheckBox Content="{x:Static res:Strings.Settings_TrayToggle}"
                IsChecked="{Binding ViewModel.MinimizeToTray, Mode=TwoWay}"
                AutomationProperties.Name="Minimize to tray toggle" Margin="{StaticResource AppGapGroup}" />

      <TextBlock Text="{x:Static res:Strings.Settings_Language}" Style="{StaticResource AppBodyText}" Margin="{StaticResource AppGapTitle}" />
      <ComboBox ItemsSource="{Binding ViewModel.CultureOptions}" DisplayMemberPath="Display"
                SelectedValuePath="Code" SelectedValue="{Binding ViewModel.SelectedCulture, Mode=TwoWay}"
                AutomationProperties.Name="Language selector" Margin="{StaticResource AppGapTitle}" />
      <TextBlock Text="{x:Static res:Strings.Settings_LanguageNote}" Style="{StaticResource AppCaptionText}" Margin="{StaticResource AppGapTitle}" />
      <ui:Button Content="{x:Static res:Strings.Settings_RestartNow}" Click="OnRestartClick"
                 AutomationProperties.Name="Restart application" Margin="{StaticResource AppGapGroup}" />

      <TextBlock Text="{Binding ViewModel.ErrorMessage, TargetNullValue=''}" Style="{StaticResource AppErrorText}" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Page>
