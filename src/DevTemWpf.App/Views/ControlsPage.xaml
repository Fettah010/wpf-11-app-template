<Page x:Class="DevTemWpf.App.Views.ControlsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="1400" d:DesignWidth="720"
      Title="Controls">
  <ScrollViewer Padding="{StaticResource AppPageMargin}" x:Name="GalleryScroller"
                AutomationProperties.Name="Controls gallery">
    <StackPanel MaxWidth="{StaticResource AppContentMaxWidth}">
      <TextBlock Text="Controls" Style="{StaticResource AppSubtitleText}" Margin="{StaticResource AppGapTitle}" />
      <TextBlock Text="Everyday controls, their states, and the patterns to use them. Full catalog: docs/design-system/components.md. Tab reaches every control and section heading; the index below jumps between sections."
                 Style="{StaticResource AppSecondaryBodyText}" TextWrapping="Wrap" Margin="{StaticResource AppGapItem}" />

      <!-- Category index (1.2.0): mouse and keyboard anchor navigation. -->
      <WrapPanel Margin="{StaticResource AppGapSection}" AutomationProperties.Name="Gallery section index">
        <ui:Button Content="Buttons" Click="OnIndexClick" Tag="ButtonsSection"
                   AutomationProperties.Name="Go to Buttons section" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="Inputs" Click="OnIndexClick" Tag="InputsSection"
                   AutomationProperties.Name="Go to Inputs section" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="Content" Click="OnIndexClick" Tag="ContentSection"
                   AutomationProperties.Name="Go to Content section" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="Feedback" Click="OnIndexClick" Tag="FeedbackSection"
                   AutomationProperties.Name="Go to Feedback section" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="Validated form" Click="OnIndexClick" Tag="FormSection"
                   AutomationProperties.Name="Go to Validated form section" Margin="{StaticResource AppGapFlow}" />
      </WrapPanel>

      <!-- Buttons -->
      <TextBlock x:Name="ButtonsSection" Focusable="True" Text="Buttons" Style="{StaticResource AppSectionHeadingText}"
                 Margin="{StaticResource AppGapTitle}" AutomationProperties.Name="Buttons section heading" />
      <TextBlock Text="Appearance sets intent: Primary for the one main action, Danger for destructive, Secondary/Transparent otherwise."
                 Style="{StaticResource AppCaptionText}" TextWrapping="Wrap" Margin="{StaticResource AppGapItem}" />
      <WrapPanel Margin="{StaticResource AppGapItem}">
        <ui:Button Content="Primary" Appearance="Primary" AutomationProperties.Name="Gallery primary button" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="Secondary" Appearance="Secondary" AutomationProperties.Name="Gallery secondary button" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="Transparent" Appearance="Transparent" AutomationProperties.Name="Gallery transparent button" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="Danger" Appearance="Danger" AutomationProperties.Name="Gallery danger button" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="With icon" Icon="{ui:SymbolIcon Checkmark24}" AutomationProperties.Name="Gallery icon button" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="Disabled" IsEnabled="False" AutomationProperties.Name="Gallery disabled button" Margin="{StaticResource AppGapFlow}" />
      </WrapPanel>
      <WrapPanel Margin="{StaticResource AppGapSection}">
        <ToggleButton Content="Toggle" AutomationProperties.Name="Gallery toggle button" Margin="{StaticResource AppGapFlow}" />
        <ui:HyperlinkButton Content="Hyperlink" AutomationProperties.Name="Gallery hyperlink button" Margin="{StaticResource AppGapFlow}" />
        <ui:SplitButton Content="Split" AutomationProperties.Name="Gallery split button" Margin="{StaticResource AppGapFlow}">
          <ui:SplitButton.Flyout>
            <ContextMenu>
              <MenuItem Header="Option A" />
              <MenuItem Header="Option B" />
            </ContextMenu>
          </ui:SplitButton.Flyout>
        </ui:SplitButton>
        <ui:Button Content="Run busy task" Command="{Binding ViewModel.RunBusyDemoCommand}"
                   IsEnabled="{Binding ViewModel.IsIdle}"
                   AutomationProperties.Name="Gallery busy demo button" Margin="{StaticResource AppGapFlow}" />
        <ui:ProgressRing IsIndeterminate="{Binding ViewModel.IsBusy}" Width="24" Height="24"
                         AutomationProperties.Name="Busy indicator" Margin="{StaticResource AppGapFlow}" />
      </WrapPanel>

      <!-- Inputs -->
      <TextBlock x:Name="InputsSection" Focusable="True" Text="Inputs" Style="{StaticResource AppSectionHeadingText}"
                 Margin="{StaticResource AppGapTitle}" AutomationProperties.Name="Inputs section heading" />
      <TextBlock Text="Placeholder + automation name on every field. Validation states are demonstrated in the form below."
                 Style="{StaticResource AppCaptionText}" TextWrapping="Wrap" Margin="{StaticResource AppGapItem}" />
      <Grid Margin="{StaticResource AppGapSection}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TextBox Grid.Row="0" Grid.Column="0" PlaceholderText="Search…" Icon="{ui:SymbolIcon Search24}"
                    AutomationProperties.Name="Gallery search input" Margin="{StaticResource AppGapFlow}" />
        <ui:PasswordBox Grid.Row="0" Grid.Column="1" PlaceholderText="Password"
                        AutomationProperties.Name="Gallery password input" Margin="{StaticResource AppGapItem}" />
        <ui:NumberBox Grid.Row="1" Grid.Column="0" PlaceholderText="42"
                      AutomationProperties.Name="Gallery number input" Margin="{StaticResource AppGapFlow}" />
        <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0"
                  AutomationProperties.Name="Gallery combo box" Margin="{StaticResource AppGapItem}">
          <ComboBoxItem Content="First" />
          <ComboBoxItem Content="Second" />
        </ComboBox>
        <Slider Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="40"
                AutomationProperties.Name="Gallery slider" Margin="{StaticResource AppGapItem}" />
      </Grid>
      <WrapPanel Margin="{StaticResource AppGapItem}">
        <CheckBox Content="Check box" IsChecked="True" AutomationProperties.Name="Gallery check box" Margin="{StaticResource AppGapInline}" />
        <ui:ToggleSwitch Content="Toggle switch" AutomationProperties.Name="Gallery toggle switch" Margin="{StaticResource AppGapInline}" />
      </WrapPanel>
      <StackPanel Orientation="Horizontal" Margin="{StaticResource AppGapSection}">
        <RadioButton Content="Alpha" IsChecked="True" AutomationProperties.Name="Gallery radio alpha" Margin="{StaticResource AppGapInline}" />
        <RadioButton Content="Beta" AutomationProperties.Name="Gallery radio beta" />
      </StackPanel>

      <!-- Content -->
      <TextBlock x:Name="ContentSection" Focusable="True" Text="Content" Style="{StaticResource AppSectionHeadingText}"
                 Margin="{StaticResource AppGapTitle}" AutomationProperties.Name="Content section heading" />
      <TextBlock Text="Cards group related content; expanders hide detail; badges annotate; tooltips explain."
                 Style="{StaticResource AppCaptionText}" TextWrapping="Wrap" Margin="{StaticResource AppGapItem}" />
      <ui:Card Margin="{StaticResource AppGapItem}" AutomationProperties.Name="Gallery card">
        <StackPanel>
          <TextBlock Text="Card title" Style="{StaticResource AppSectionHeadingText}" />
          <TextBlock Text="Card body copy." Style="{StaticResource AppSecondaryBodyText}" TextWrapping="Wrap" />
        </StackPanel>
      </ui:Card>
      <ui:CardExpander Header="Card expander" Content="Hidden detail lives here."
                       AutomationProperties.Name="Gallery card expander" Margin="{StaticResource AppGapItem}" />
      <Expander Header="Expander" AutomationProperties.Name="Gallery expander" Margin="{StaticResource AppGapItem}">
        <TextBlock Text="Expandable content." Style="{StaticResource AppBodyText}" />
      </Expander>
      <WrapPanel Margin="{StaticResource AppGapSection}">
        <ui:InfoBadge Value="7" AutomationProperties.Name="Gallery info badge" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="Hover for tooltip" ToolTip="Tooltips explain — they never carry the only copy of information."
                   AutomationProperties.Name="Gallery tooltip button" Margin="{StaticResource AppGapFlow}" />
      </WrapPanel>

      <!-- Feedback -->
      <TextBlock x:Name="FeedbackSection" Focusable="True" Text="Feedback" Style="{StaticResource AppSectionHeadingText}"
                 Margin="{StaticResource AppGapTitle}" AutomationProperties.Name="Feedback section heading" />
      <TextBlock Text="InfoBar for inline severity; snackbar for transient confirmation; dialog for decisions that need an explicit answer."
                 Style="{StaticResource AppCaptionText}" TextWrapping="Wrap" Margin="{StaticResource AppGapItem}" />
      <ui:InfoBar Title="Informational" Message="Neutral context lives here." Severity="Informational" IsOpen="True"
                  AutomationProperties.Name="Gallery info bar informational" Margin="{StaticResource AppGapItem}" />
      <ui:InfoBar Title="Success" Message="The thing worked." Severity="Success" IsOpen="True"
                  AutomationProperties.Name="Gallery info bar success" Margin="{StaticResource AppGapItem}" />
      <ui:InfoBar Title="Warning" Message="Check this before continuing." Severity="Warning" IsOpen="True"
                  AutomationProperties.Name="Gallery info bar warning" Margin="{StaticResource AppGapItem}" />
      <ui:InfoBar Title="Error" Message="Something failed; here is what to do." Severity="Error" IsOpen="True"
                  AutomationProperties.Name="Gallery info bar error" Margin="{StaticResource AppGapItem}" />
      <ProgressBar Value="62" AutomationProperties.Name="Gallery determinate progress" Margin="{StaticResource AppGapItem}" />
      <ProgressBar IsIndeterminate="True" AutomationProperties.Name="Gallery indeterminate progress" Margin="{StaticResource AppGapItem}" />
      <WrapPanel Margin="{StaticResource AppGapItem}">
        <ui:Button Content="Show snackbar" Command="{Binding ViewModel.ShowSnackbarCommand}"
                   AutomationProperties.Name="Gallery snackbar demo" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="Ask for confirmation" Command="{Binding ViewModel.ShowConfirmDialogCommand}"
                   AutomationProperties.Name="Gallery dialog demo" Margin="{StaticResource AppGapFlow}" />
      </WrapPanel>
      <TextBlock Text="{Binding ViewModel.StatusText}" Style="{StaticResource AppSecondaryBodyText}"
                 TextWrapping="Wrap" Margin="{StaticResource AppGapSection}" AutomationProperties.Name="Demo status line" />

      <!-- Validated form -->
      <TextBlock x:Name="FormSection" Focusable="True" Text="Validated form" Style="{StaticResource AppSectionHeadingText}"
                 Margin="{StaticResource AppGapTitle}" AutomationProperties.Name="Validated form section heading" />
      <TextBlock Text="DataAnnotations + ObservableValidator. Errors appear under fields and block saving — never color-only."
                 Style="{StaticResource AppCaptionText}" TextWrapping="Wrap" Margin="{StaticResource AppGapItem}" />
      <TextBlock Text="Name" Style="{StaticResource AppBodyText}" Margin="{StaticResource AppGapTitle}" />
      <ui:TextBox Text="{Binding ViewModel.Form.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  PlaceholderText="Ada Lovelace"
                  AutomationProperties.Name="Sample form name" Margin="{StaticResource AppGapTitle}" />
      <TextBlock Text="{Binding ViewModel.Form.NameError, TargetNullValue=''}" Style="{StaticResource AppErrorText}" Margin="{StaticResource AppGapItem}" />
      <TextBlock Text="Email" Style="{StaticResource AppBodyText}" Margin="{StaticResource AppGapTitle}" />
      <ui:TextBox Text="{Binding ViewModel.Form.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  PlaceholderText="ada@example.com"
                  AutomationProperties.Name="Sample form email" Margin="{StaticResource AppGapTitle}" />
      <TextBlock Text="{Binding ViewModel.Form.EmailError, TargetNullValue=''}" Style="{StaticResource AppErrorText}" Margin="{StaticResource AppGapItem}" />
      <WrapPanel>
        <ui:Button Content="Save sample" Command="{Binding ViewModel.Form.SaveCommand}" Appearance="Primary"
                   AutomationProperties.Name="Sample form save" Margin="{StaticResource AppGapFlow}" />
      </WrapPanel>
      <TextBlock Text="{Binding ViewModel.Form.SavedMessage, TargetNullValue=''}" Style="{StaticResource AppSecondaryBodyText}"
                 TextWrapping="Wrap" AutomationProperties.Name="Sample form result" />
    </StackPanel>
  </ScrollViewer>
</Page>
