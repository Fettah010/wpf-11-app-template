<Page x:Class="DevTemWpf.App.Views.ControlsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
       xmlns:res="clr-namespace:DevTemWpf.App.Resources"
      mc:Ignorable="d"
      d:DesignHeight="1400" d:DesignWidth="720"
      Title="{x:Static res:Strings.Ctl_Title}">
  <ScrollViewer Padding="{StaticResource AppPageMargin}" x:Name="GalleryScroller"
                AutomationProperties.Name="Controls gallery">
    <StackPanel MaxWidth="{StaticResource AppContentMaxWidth}">
      <TextBlock Text="{x:Static res:Strings.Ctl_Title}" Style="{StaticResource AppSubtitleText}" Margin="{StaticResource AppGapTitle}" />
      <TextBlock Text="{x:Static res:Strings.Ctl_Description}"
                 Style="{StaticResource AppSecondaryBodyText}" TextWrapping="Wrap" Margin="{StaticResource AppGapItem}" />

      <!-- Category index (1.2.0): mouse and keyboard anchor navigation. -->
      <WrapPanel Margin="{StaticResource AppGapSection}" AutomationProperties.Name="Gallery section index">
        <ui:Button Content="{x:Static res:Strings.Ctl_Buttons}" Click="OnIndexClick" Tag="ButtonsSection"
                   AutomationProperties.Name="Go to Buttons section" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="{x:Static res:Strings.Ctl_Inputs}" Click="OnIndexClick" Tag="InputsSection"
                   AutomationProperties.Name="Go to Inputs section" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="{x:Static res:Strings.Ctl_Content}" Click="OnIndexClick" Tag="ContentSection"
                   AutomationProperties.Name="Go to Content section" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="{x:Static res:Strings.Ctl_Feedback}" Click="OnIndexClick" Tag="FeedbackSection"
                   AutomationProperties.Name="Go to Feedback section" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="{x:Static res:Strings.Ctl_ValidatedForm}" Click="OnIndexClick" Tag="FormSection"
                   AutomationProperties.Name="Go to Validated form section" Margin="{StaticResource AppGapFlow}" />
      </WrapPanel>

      <!-- Buttons -->
      <TextBlock x:Name="ButtonsSection" Focusable="True" Text="{x:Static res:Strings.Ctl_Buttons}" Style="{StaticResource AppSectionHeadingText}"
                 Margin="{StaticResource AppGapTitle}" AutomationProperties.Name="Buttons section heading" />
      <TextBlock Text="{x:Static res:Strings.Ctl_ButtonsNote}"
                 Style="{StaticResource AppCaptionText}" TextWrapping="Wrap" Margin="{StaticResource AppGapItem}" />
      <WrapPanel Margin="{StaticResource AppGapItem}">
        <ui:Button Content="{x:Static res:Strings.Ctl_BtnPrimary}" Appearance="Primary" AutomationProperties.Name="Gallery primary button" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="{x:Static res:Strings.Ctl_BtnSecondary}" Appearance="Secondary" AutomationProperties.Name="Gallery secondary button" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="{x:Static res:Strings.Ctl_BtnTransparent}" Appearance="Transparent" AutomationProperties.Name="Gallery transparent button" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="{x:Static res:Strings.Ctl_BtnDanger}" Appearance="Danger" AutomationProperties.Name="Gallery danger button" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="{x:Static res:Strings.Ctl_BtnIcon}" Icon="{ui:SymbolIcon Checkmark24}" AutomationProperties.Name="Gallery icon button" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="{x:Static res:Strings.Ctl_BtnDisabled}" IsEnabled="False" AutomationProperties.Name="Gallery disabled button" Margin="{StaticResource AppGapFlow}" />
      </WrapPanel>
      <WrapPanel Margin="{StaticResource AppGapSection}">
        <ToggleButton Content="{x:Static res:Strings.Ctl_BtnToggle}" AutomationProperties.Name="Gallery toggle button" Margin="{StaticResource AppGapFlow}" />
        <ui:HyperlinkButton Content="{x:Static res:Strings.Ctl_BtnHyperlink}" AutomationProperties.Name="Gallery hyperlink button" Margin="{StaticResource AppGapFlow}" />
        <ui:SplitButton Content="{x:Static res:Strings.Ctl_BtnSplit}" AutomationProperties.Name="Gallery split button" Margin="{StaticResource AppGapFlow}">
          <ui:SplitButton.Flyout>
            <ContextMenu>
              <MenuItem Header="{x:Static res:Strings.Ctl_OptA}" />
              <MenuItem Header="{x:Static res:Strings.Ctl_OptB}" />
            </ContextMenu>
          </ui:SplitButton.Flyout>
        </ui:SplitButton>
        <ui:Button Content="{x:Static res:Strings.Ctl_BtnBusy}" Command="{Binding ViewModel.RunBusyDemoCommand}"
                   IsEnabled="{Binding ViewModel.IsIdle}"
                   AutomationProperties.Name="Gallery busy demo button" Margin="{StaticResource AppGapFlow}" />
        <ui:ProgressRing IsIndeterminate="{Binding ViewModel.IsBusy}" Width="24" Height="24"
                         AutomationProperties.Name="Busy indicator" Margin="{StaticResource AppGapFlow}" />
      </WrapPanel>

      <!-- Inputs -->
      <TextBlock x:Name="InputsSection" Focusable="True" Text="{x:Static res:Strings.Ctl_Inputs}" Style="{StaticResource AppSectionHeadingText}"
                 Margin="{StaticResource AppGapTitle}" AutomationProperties.Name="Inputs section heading" />
      <TextBlock Text="{x:Static res:Strings.Ctl_InputsNote}"
                 Style="{StaticResource AppCaptionText}" TextWrapping="Wrap" Margin="{StaticResource AppGapItem}" />
      <Grid Margin="{StaticResource AppGapSection}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <ui:TextBox Grid.Row="0" Grid.Column="0" PlaceholderText="{x:Static res:Strings.Ctl_SearchPh}" Icon="{ui:SymbolIcon Search24}"
                    AutomationProperties.Name="Gallery search input" Margin="{StaticResource AppGapFlow}" />
        <ui:PasswordBox Grid.Row="0" Grid.Column="1" PlaceholderText="{x:Static res:Strings.Ctl_PasswordPh}"
                        AutomationProperties.Name="Gallery password input" Margin="{StaticResource AppGapItem}" />
        <ui:NumberBox Grid.Row="1" Grid.Column="0" PlaceholderText="42"
                      AutomationProperties.Name="Gallery number input" Margin="{StaticResource AppGapFlow}" />
        <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="0"
                  AutomationProperties.Name="Gallery combo box" Margin="{StaticResource AppGapItem}">
          <ComboBoxItem Content="{x:Static res:Strings.Ctl_First}" />
          <ComboBoxItem Content="{x:Static res:Strings.Ctl_Second}" />
        </ComboBox>
        <Slider Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="40"
                AutomationProperties.Name="Gallery slider" Margin="{StaticResource AppGapItem}" />
      </Grid>
      <WrapPanel Margin="{StaticResource AppGapItem}">
        <CheckBox Content="{x:Static res:Strings.Ctl_CheckBox}" IsChecked="True" AutomationProperties.Name="Gallery check box" Margin="{StaticResource AppGapInline}" />
        <ui:ToggleSwitch Content="{x:Static res:Strings.Ctl_ToggleSwitch}" AutomationProperties.Name="Gallery toggle switch" Margin="{StaticResource AppGapInline}" />
      </WrapPanel>
      <StackPanel Orientation="Horizontal" Margin="{StaticResource AppGapSection}">
        <RadioButton Content="{x:Static res:Strings.Ctl_RadioAlpha}" IsChecked="True" AutomationProperties.Name="Gallery radio alpha" Margin="{StaticResource AppGapInline}" />
        <RadioButton Content="{x:Static res:Strings.Ctl_RadioBeta}" AutomationProperties.Name="Gallery radio beta" />
      </StackPanel>

      <!-- Content -->
      <TextBlock x:Name="ContentSection" Focusable="True" Text="{x:Static res:Strings.Ctl_Content}" Style="{StaticResource AppSectionHeadingText}"
                 Margin="{StaticResource AppGapTitle}" AutomationProperties.Name="Content section heading" />
      <TextBlock Text="{x:Static res:Strings.Ctl_ContentNote}"
                 Style="{StaticResource AppCaptionText}" TextWrapping="Wrap" Margin="{StaticResource AppGapItem}" />
      <ui:Card Margin="{StaticResource AppGapItem}" AutomationProperties.Name="Gallery card">
        <StackPanel>
          <TextBlock Text="{x:Static res:Strings.Ctl_CardTitle}" Style="{StaticResource AppSectionHeadingText}" />
          <TextBlock Text="{x:Static res:Strings.Ctl_CardBody}" Style="{StaticResource AppSecondaryBodyText}" TextWrapping="Wrap" />
        </StackPanel>
      </ui:Card>
      <ui:CardExpander Header="{x:Static res:Strings.Ctl_CardExpander}" Content="{x:Static res:Strings.Ctl_HiddenDetail}"
                       AutomationProperties.Name="Gallery card expander" Margin="{StaticResource AppGapItem}" />
      <Expander Header="{x:Static res:Strings.Ctl_Expander}" AutomationProperties.Name="Gallery expander" Margin="{StaticResource AppGapItem}">
        <TextBlock Text="{x:Static res:Strings.Ctl_ExpandableContent}" Style="{StaticResource AppBodyText}" />
      </Expander>
      <WrapPanel Margin="{StaticResource AppGapSection}">
        <ui:InfoBadge Value="7" AutomationProperties.Name="Gallery info badge" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="{x:Static res:Strings.Ctl_TooltipBtn}" ToolTip="{x:Static res:Strings.Ctl_TooltipText}"
                   AutomationProperties.Name="Gallery tooltip button" Margin="{StaticResource AppGapFlow}" />
      </WrapPanel>

      <!-- Feedback -->
      <TextBlock x:Name="FeedbackSection" Focusable="True" Text="{x:Static res:Strings.Ctl_Feedback}" Style="{StaticResource AppSectionHeadingText}"
                 Margin="{StaticResource AppGapTitle}" AutomationProperties.Name="Feedback section heading" />
      <TextBlock Text="{x:Static res:Strings.Ctl_FeedbackNote}"
                 Style="{StaticResource AppCaptionText}" TextWrapping="Wrap" Margin="{StaticResource AppGapItem}" />
      <ui:InfoBar Title="{x:Static res:Strings.Ctl_SeverityInformational}" Message="{x:Static res:Strings.Ctl_InfoNeutralMsg}" Severity="Informational" IsOpen="True"
                  AutomationProperties.Name="Gallery info bar informational" Margin="{StaticResource AppGapItem}" />
      <ui:InfoBar Title="{x:Static res:Strings.Ctl_SeveritySuccess}" Message="{x:Static res:Strings.Ctl_InfoSuccessMsg}" Severity="Success" IsOpen="True"
                  AutomationProperties.Name="Gallery info bar success" Margin="{StaticResource AppGapItem}" />
      <ui:InfoBar Title="{x:Static res:Strings.Ctl_SeverityWarning}" Message="{x:Static res:Strings.Ctl_InfoWarningMsg}" Severity="Warning" IsOpen="True"
                  AutomationProperties.Name="Gallery info bar warning" Margin="{StaticResource AppGapItem}" />
      <ui:InfoBar Title="{x:Static res:Strings.Ctl_SeverityError}" Message="{x:Static res:Strings.Ctl_InfoErrorMsg}" Severity="Error" IsOpen="True"
                  AutomationProperties.Name="Gallery info bar error" Margin="{StaticResource AppGapItem}" />
      <ProgressBar Value="62" AutomationProperties.Name="Gallery determinate progress" Margin="{StaticResource AppGapItem}" />
      <ProgressBar IsIndeterminate="True" AutomationProperties.Name="Gallery indeterminate progress" Margin="{StaticResource AppGapItem}" />
      <WrapPanel Margin="{StaticResource AppGapItem}">
        <ui:Button Content="{x:Static res:Strings.Ctl_BtnSnackbar}" Command="{Binding ViewModel.ShowSnackbarCommand}"
                   AutomationProperties.Name="Gallery snackbar demo" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="{x:Static res:Strings.Ctl_BtnDialog}" Command="{Binding ViewModel.ShowConfirmDialogCommand}"
                   AutomationProperties.Name="Gallery dialog demo" Margin="{StaticResource AppGapFlow}" />
      </WrapPanel>
      <TextBlock Text="{Binding ViewModel.StatusText}" Style="{StaticResource AppSecondaryBodyText}"
                 TextWrapping="Wrap" Margin="{StaticResource AppGapSection}" AutomationProperties.Name="Demo status line" />

      <!-- Validated form -->
      <TextBlock x:Name="FormSection" Focusable="True" Text="{x:Static res:Strings.Ctl_ValidatedForm}" Style="{StaticResource AppSectionHeadingText}"
                 Margin="{StaticResource AppGapTitle}" AutomationProperties.Name="Validated form section heading" />
      <TextBlock Text="{x:Static res:Strings.Ctl_FormNote}"
                 Style="{StaticResource AppCaptionText}" TextWrapping="Wrap" Margin="{StaticResource AppGapItem}" />
      <TextBlock Text="{x:Static res:Strings.Ctl_FormName}" Style="{StaticResource AppBodyText}" Margin="{StaticResource AppGapTitle}" />
      <ui:TextBox Text="{Binding ViewModel.Form.Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  PlaceholderText="Ada Lovelace"
                  AutomationProperties.Name="Sample form name" Margin="{StaticResource AppGapTitle}" />
      <TextBlock Text="{Binding ViewModel.Form.NameError, TargetNullValue=''}" Style="{StaticResource AppErrorText}" Margin="{StaticResource AppGapItem}" />
      <TextBlock Text="{x:Static res:Strings.Ctl_FormEmail}" Style="{StaticResource AppBodyText}" Margin="{StaticResource AppGapTitle}" />
      <ui:TextBox Text="{Binding ViewModel.Form.Email, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  PlaceholderText="ada@example.com"
                  AutomationProperties.Name="Sample form email" Margin="{StaticResource AppGapTitle}" />
      <TextBlock Text="{Binding ViewModel.Form.EmailError, TargetNullValue=''}" Style="{StaticResource AppErrorText}" Margin="{StaticResource AppGapItem}" />
      <WrapPanel>
        <ui:Button Content="{x:Static res:Strings.Ctl_BtnSave}" Command="{Binding ViewModel.Form.SaveCommand}" Appearance="Primary"
                   AutomationProperties.Name="Sample form save" Margin="{StaticResource AppGapFlow}" />
      </WrapPanel>
      <TextBlock Text="{Binding ViewModel.Form.SavedMessage, TargetNullValue=''}" Style="{StaticResource AppSecondaryBodyText}"
                 TextWrapping="Wrap" AutomationProperties.Name="Sample form result" />
    </StackPanel>
  </ScrollViewer>
</Page>
