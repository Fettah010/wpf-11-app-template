<Page x:Class="DevTemWpf.App.Views.DiagnosticsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
       xmlns:res="clr-namespace:DevTemWpf.App.Resources"
      mc:Ignorable="d"
      d:DesignHeight="900" d:DesignWidth="720"
      Title="{x:Static res:Strings.Dia_Title}">
  <ScrollViewer Padding="{StaticResource AppPageMargin}"
                AutomationProperties.Name="Diagnostics">
    <StackPanel MaxWidth="{StaticResource AppContentMaxWidth}">
      <TextBlock Text="{x:Static res:Strings.Dia_Title}" Style="{StaticResource AppSubtitleText}" Margin="{StaticResource AppGapTitle}" />
      <TextBlock Text="{x:Static res:Strings.Dia_Description}"
                 Style="{StaticResource AppSecondaryBodyText}" TextWrapping="Wrap" Margin="{StaticResource AppGapSection}" />

      <TextBlock Text="{x:Static res:Strings.Dia_Logs}" Style="{StaticResource AppSectionHeadingText}" Margin="{StaticResource AppGapTitle}" />
      <ui:TextBox PlaceholderText="{x:Static res:Strings.Dia_FilterPh}" Text="{Binding ViewModel.LogFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                  AutomationProperties.Name="Log filter" Margin="{StaticResource AppGapItem}" />
      <ListBox ItemsSource="{Binding ViewModel.LogLines}" Height="180" FontFamily="{StaticResource AppMonoFontFamily}"
               FontSize="12" AutomationProperties.Name="Log viewer" Margin="{StaticResource AppGapItem}" />
      <WrapPanel Margin="{StaticResource AppGapTitle}">
        <ui:Button Content="{x:Static res:Strings.Dia_Refresh}" Command="{Binding ViewModel.RefreshLogsCommand}"
                   AutomationProperties.Name="Refresh logs" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="{x:Static res:Strings.Dia_Export}" Click="OnExportLogClick"
                   AutomationProperties.Name="Export log" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="{x:Static res:Strings.Dia_Bundle}" Click="OnBundleClick"
                   AutomationProperties.Name="Create support bundle" Margin="{StaticResource AppGapFlow}" />
      </WrapPanel>
      <TextBlock Text="{Binding ViewModel.LogStatus}" Style="{StaticResource AppCaptionText}" Margin="{StaticResource AppGapSection}" />

      <TextBlock Text="{x:Static res:Strings.Dia_Backup}" Style="{StaticResource AppSectionHeadingText}" Margin="{StaticResource AppGapTitle}" />
      <WrapPanel Margin="{StaticResource AppGapTitle}">
        <ui:Button Content="{x:Static res:Strings.Dia_BackupNow}" Command="{Binding ViewModel.BackupNowCommand}"
                   AutomationProperties.Name="{x:Static res:Strings.Dia_BackupNow}" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="{x:Static res:Strings.Dia_Restore}" Click="OnRestoreClick"
                   AutomationProperties.Name="Restore backup" Margin="{StaticResource AppGapFlow}" />
      </WrapPanel>
      <TextBlock Text="{Binding ViewModel.BackupStatus}" Style="{StaticResource AppSecondaryBodyText}"
                 TextWrapping="Wrap" Margin="{StaticResource AppGapSection}" AutomationProperties.Name="Backup status" />

      <TextBlock Text="{x:Static res:Strings.Dia_Updates}" Style="{StaticResource AppSectionHeadingText}" Margin="{StaticResource AppGapTitle}" />
      <ComboBox ItemsSource="{Binding ViewModel.ChannelOptions}"
                SelectedItem="{Binding ViewModel.SelectedChannel, Mode=TwoWay}"
                AutomationProperties.Name="Update channel" Margin="{StaticResource AppGapTitle}" />
      <TextBlock Text="{Binding ViewModel.FeedUrlText}" Style="{StaticResource AppCaptionText}" Margin="{StaticResource AppGapItem}" />
      <TextBlock Text="{Binding ViewModel.UpdateVersionsText}" Style="{StaticResource AppSecondaryBodyText}"
                 AutomationProperties.Name="Update versions" Margin="{StaticResource AppGapItem}" />
      <ui:ToggleSwitch Content="{x:Static res:Strings.Update_AllowDowngrade}"
                       IsChecked="{Binding ViewModel.AllowDowngrade, Mode=TwoWay}"
                       Checked="OnAllowDowngradeChecked"
                       AutomationProperties.Name="{x:Static res:Strings.Update_AllowDowngrade}"
                       Margin="{StaticResource AppGapItem}" />
      <WrapPanel Margin="{StaticResource AppGapTitle}">
        <ui:Button Content="{x:Static res:Strings.Dia_CheckUpdates}" Command="{Binding ViewModel.CheckUpdatesCommand}"
                   AutomationProperties.Name="{x:Static res:Strings.Dia_CheckUpdates}" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="{x:Static res:Strings.Update_Retry}" Command="{Binding ViewModel.RetryUpdatesCommand}"
                   AutomationProperties.Name="{x:Static res:Strings.Update_Retry}" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="{x:Static res:Strings.Update_Cancel}" Command="{Binding ViewModel.CancelUpdatesCommand}"
                   AutomationProperties.Name="{x:Static res:Strings.Update_Cancel}" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="{x:Static res:Strings.Dia_DownloadRestart}" Command="{Binding ViewModel.DownloadUpdatesCommand}"
                   AutomationProperties.Name="Download and restart" Margin="{StaticResource AppGapFlow}" />
        <ui:Button Content="{x:Static res:Strings.Update_RestartNow}" Command="{Binding ViewModel.RestartUpdatesCommand}"
                   AutomationProperties.Name="{x:Static res:Strings.Update_RestartNow}" Margin="{StaticResource AppGapFlow}" />
      </WrapPanel>
      <TextBlock Text="{Binding ViewModel.Update.Detail}" Style="{StaticResource AppSecondaryBodyText}"
                 TextWrapping="Wrap" AutomationProperties.Name="Update status" />
      <ProgressBar Value="{Binding ViewModel.Update.Progress, Mode=OneWay}" Minimum="0" Maximum="1" Height="6"
                   Margin="{StaticResource AppGapSection}" AutomationProperties.Name="Update progress" />

      <TextBlock Text="{x:Static res:Strings.Dia_Connectivity}" Style="{StaticResource AppSectionHeadingText}" Margin="{StaticResource AppGapTitle}" />
      <TextBlock Text="{Binding ViewModel.HttpBaseUrl, StringFormat=Endpoint: {0}}" Style="{StaticResource AppCaptionText}" Margin="{StaticResource AppGapTitle}" />
      <WrapPanel Margin="{StaticResource AppGapTitle}">
        <ui:Button Content="{x:Static res:Strings.Dia_Probe}" Command="{Binding ViewModel.ProbeHttpCommand}"
                   AutomationProperties.Name="{x:Static res:Strings.Dia_Probe}" Margin="{StaticResource AppGapFlow}" />
      </WrapPanel>
      <TextBlock Text="{Binding ViewModel.ProbeResult}" Style="{StaticResource AppSecondaryBodyText}"
                 TextWrapping="Wrap" Margin="{StaticResource AppGapSection}" AutomationProperties.Name="Probe result" />

      <TextBlock Text="{x:Static res:Strings.Dia_Paths}" Style="{StaticResource AppSectionHeadingText}" Margin="{StaticResource AppGapTitle}" />
      <TextBlock Text="{Binding ViewModel.PathsText}" Style="{StaticResource AppCaptionText}"
                 FontFamily="{StaticResource AppMonoFontFamily}" TextWrapping="Wrap" Margin="{StaticResource AppGapItem}" />
      <TextBlock Text="{x:Static res:Strings.Dia_Versions}" Style="{StaticResource AppSectionHeadingText}" Margin="{StaticResource AppGapTitle}" />
      <TextBlock Text="{Binding ViewModel.VersionsText}" Style="{StaticResource AppCaptionText}"
                 FontFamily="{StaticResource AppMonoFontFamily}" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Page>
