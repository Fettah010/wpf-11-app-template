<Page x:Class="DevTemWpf.App.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="480" d:DesignWidth="720"
      Title="Home">
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
              MaxWidth="{StaticResource AppContentMaxWidth}"
              Margin="{StaticResource AppPageMargin}">
    <ui:SymbolIcon Symbol="Home24" FontSize="{StaticResource AppIconXLarge}"
                   HorizontalAlignment="Center" Margin="0,0,0,16" />
    <TextBlock Text="{Binding ViewModel.Headline}" Style="{StaticResource AppTitleText}"
               TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8"
               AutomationProperties.Name="Home headline" />
    <TextBlock Text="{Binding ViewModel.Subline}" Style="{StaticResource AppSecondaryBodyText}"
               TextAlignment="Center" TextWrapping="Wrap" />
  </StackPanel>
</Page>
