<Page x:Class="DevTemWpf.App.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      mc:Ignorable="d"
      d:DesignHeight="480" d:DesignWidth="720"
      Title="Home">
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="520">
    <ui:SymbolIcon Symbol="Home24" FontSize="56" HorizontalAlignment="Center" Margin="0,0,0,16" />
    <TextBlock Text="{Binding ViewModel.Headline}" FontSize="22" FontWeight="SemiBold"
               TextAlignment="Center" TextWrapping="Wrap" Margin="0,0,0,8" />
    <TextBlock Text="{Binding ViewModel.Subline}" TextAlignment="Center"
               TextWrapping="Wrap" Opacity="0.75" />
  </StackPanel>
</Page>
