<Page x:Class="DevTemWpf.App.Views.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
       xmlns:res="clr-namespace:DevTemWpf.App.Resources"
      mc:Ignorable="d"
      d:DesignHeight="480" d:DesignWidth="720"
      Title="{x:Static res:Strings.Home_Title}">
  <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center"
              MaxWidth="{StaticResource AppContentMaxWidth}"
              Margin="{StaticResource AppPageMargin}">
    <ui:SymbolIcon Symbol="Home24" FontSize="{StaticResource AppIconXLarge}"
                   HorizontalAlignment="Center" Margin="{StaticResource AppGapSection}" />
    <TextBlock Text="{Binding ViewModel.Headline}" Style="{StaticResource AppTitleText}"
               TextAlignment="Center" TextWrapping="Wrap" Margin="{StaticResource AppGapItem}"
               AutomationProperties.Name="Home headline" />
    <TextBlock Text="{Binding ViewModel.Subline}" Style="{StaticResource AppSecondaryBodyText}"
               TextAlignment="Center" TextWrapping="Wrap" />
  </StackPanel>
</Page>
